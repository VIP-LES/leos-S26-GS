# ── TimescaleDB / Postgres ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=postgres
PGSSL=false

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Ingest API ──
INGEST_PORT=4000
INGEST_URL=http://localhost:4000

# ── File path ──
LAUNCH_DATA_FILE=./launch_data.txt
